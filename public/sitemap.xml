<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!--
    One entry per indexable URL. Fragment URLs (/#pricing and friends) are not
    separate documents: search engines consolidate them into the page they
    belong to, so listing them only added duplicate noise.

    Each entry carries the complete hreflang cluster, self-reference included.
    A cluster that omits the self link, or points at a URL that 404s, is
    discarded in full — which is what the previous /es/ alternate did, taking
    the English signal down with it.
  -->

  <!-- English (default) -->
  <url>
    <loc>https://www.hermesv.io/</loc>
    <lastmod>2026-08-29</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="en" href="https://www.hermesv.io/" />
    <xhtml:link rel="alternate" hreflang="es-419" href="https://www.hermesv.io/es" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.hermesv.io/" />
  </url>

  <!-- Spanish (Latin America) -->
  <url>
    <loc>https://www.hermesv.io/es</loc>
    <lastmod>2026-08-29</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="en" href="https://www.hermesv.io/" />
    <xhtml:link rel="alternate" hreflang="es-419" href="https://www.hermesv.io/es" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.hermesv.io/" />
  </url>

</urlset>
