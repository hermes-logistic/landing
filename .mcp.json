{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--executablePath=/usr/bin/chromium",
        "--enable-gpu",
        "--use-gl=angle",
        "--headless",
        "--chrome-arg=--no-sandbox"
      ]
    },
    "pencil": {
      "type": "stdio",
      "command": "/home/node/.pencil/mcp/visual_studio_code/out/mcp-server-linux-x64",
      "args": [
        "--app",
        "visual_studio_code"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "playwright-mcp@latest"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ]
    }
  }
}
